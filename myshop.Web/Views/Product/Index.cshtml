@{
    ViewBag.PageTitle = "Products";
    ViewBag.PageSubtitle = "Create, edit and remove the products in your catalog.";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

@section PageActions {
    <a asp-controller="Product" asp-action="Create" class="btn btn-primary">
        <i class="fa-solid fa-circle-plus me-1" aria-hidden="true"></i> Create product
    </a>
}

<div class="card">
    <div class="card-header">
        <h2 class="card-title mb-0">Product catalog</h2>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table id="mytable" class="table table-hover align-middle" style="width:100%">
                <thead>
                    <tr>
                        <th scope="col">Product</th>
                        <th scope="col">Description</th>
                        <th scope="col">Price</th>
                        <th scope="col">Category</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/products.js" asp-append-version="true"></script>
}
