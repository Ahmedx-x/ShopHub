@using myshop.Entities.ViewModels
@model ProductVM

@{
    ViewBag.PageTitle = "Edit product";
    ViewBag.PageSubtitle = "Update the details of an existing product.";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

@section PageActions {
    <a asp-controller="Product" asp-action="Index" class="btn btn-app-ghost">
        <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i> Back to products
    </a>
}

<div class="card admin-form-card">
    <div class="card-body">
        <form asp-controller="Product" asp-action="Edit" method="post" enctype="multipart/form-data" novalidate>
            <input type="hidden" asp-for="Product.Id" />
            <input type="hidden" asp-for="Product.Img" />
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="row g-4">
                <div class="col-lg-7">
                    <p class="form-section-title">Product details</p>

                    <div class="mb-3">
                        <label asp-for="Product.Name" class="form-label"></label>
                        <input asp-for="Product.Name" class="form-control" />
                        <span asp-validation-for="Product.Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Product.Description" class="form-label"></label>
                        <textarea asp-for="Product.Description" rows="4" class="form-control"></textarea>
                        <span asp-validation-for="Product.Description" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-sm-6 mb-3">
                            <label asp-for="Product.Price" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Product.Price" type="number" step="0.01" min="0" class="form-control" />
                            </div>
                            <span asp-validation-for="Product.Price" class="text-danger"></span>
                        </div>

                        <div class="col-sm-6 mb-3">
                            <label asp-for="Product.CategoryId" class="form-label"></label>
                            <select asp-for="Product.CategoryId" class="form-select"
                                    asp-items="@(new SelectList(Model.CategoryList, "Id", "Name"))">
                                <option value="">-- Select category --</option>
                            </select>
                            <span asp-validation-for="Product.CategoryId" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5">
                    <p class="form-section-title">Product image</p>
                    <label asp-for="Product.Img" class="form-label">Replace image</label>
                    <input type="file" name="file" class="form-control" accept=".jpg,.jpeg,.png,.webp"
                           data-image-preview="ImagePreview" />
                    <p class="form-text">Leave empty to keep the current image. JPG, PNG or WEBP, max 2 MB.</p>

                    <div class="mt-3 text-center">
                        <img id="ImagePreview" class="image-preview"
                             src="@(!string.IsNullOrWhiteSpace(Model.Product.Img) ? Url.Content("~/" + Model.Product.Img) : "")"
                             alt="Current product image" />
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a asp-controller="Product" asp-action="Index" class="btn btn-app-ghost">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i> Save changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
