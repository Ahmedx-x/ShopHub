@model Pagination<Category>

@{
    ViewBag.PageTitle = "Categories";
    ViewBag.PageSubtitle = "Organize your catalog into categories.";
    Layout = "~/Views/Shared/_Dashboard.cshtml";

    var windowStart = Math.Max(1, Model.PageNumber - 2);
    var windowEnd = Math.Min(Model.TotalPages, Model.PageNumber + 2);
}

@section PageActions {
    <a asp-controller="Category" asp-action="Create" class="btn btn-primary">
        <i class="fa-solid fa-circle-plus me-1" aria-hidden="true"></i> Create category
    </a>
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h2 class="card-title mb-0">All categories</h2>
        <span class="badge-app badge-app--muted">@Model.TotalItems total</span>
    </div>
    <div class="card-body">
        @if (Model.Items.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Description</th>
                            <th scope="col">Date created</th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold">@item.Name</td>
                                <td><div class="clamp-2 text-muted-app">@item.Description</div></td>
                                <td>@item.CreatedTime.ToString("dd MMM yyyy")</td>
                                <td>
                                    <div class="action-group justify-content-end">
                                        <a asp-controller="Category" asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary" aria-label="Edit @item.Name">
                                            <i class="fa-solid fa-pen" aria-hidden="true"></i>
                                        </a>
                                        <a asp-controller="Category" asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger" aria-label="Delete @item.Name">
                                            <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="pagination-app justify-content-center justify-content-md-end" aria-label="Category pagination">
                    @if (Model.PageNumber > 1)
                    {
                        <a asp-action="Index" asp-route-pageNumber="@(Model.PageNumber - 1)" aria-label="Previous page">
                            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
                        </a>
                    }
                    @for (var i = windowStart; i <= windowEnd; i++)
                    {
                        if (i == Model.PageNumber)
                        {
                            <span class="is-active" aria-current="page">@i</span>
                        }
                        else
                        {
                            <a asp-action="Index" asp-route-pageNumber="@i">@i</a>
                        }
                    }
                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <a asp-action="Index" asp-route-pageNumber="@(Model.PageNumber + 1)" aria-label="Next page">
                            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                        </a>
                    }
                </nav>
            }
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state__icon" aria-hidden="true"><i class="fa-solid fa-folder-open"></i></div>
                <h3>No categories yet</h3>
                <p>Create your first category to start organizing products.</p>
                <a asp-controller="Category" asp-action="Create" class="btn btn-primary">Create category</a>
            </div>
        }
    </div>
</div>
