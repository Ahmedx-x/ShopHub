@model Category

@{
    ViewBag.PageTitle = "Create category";
    ViewBag.PageSubtitle = "Add a new category to organize your products.";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

@section PageActions {
    <a asp-controller="Category" asp-action="Index" class="btn btn-app-ghost">
        <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i> Back to categories
    </a>
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card admin-form-card">
            <div class="card-body">
                <form asp-controller="Category" asp-action="Create" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Electronics" autofocus />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" rows="4" class="form-control"
                                  placeholder="Describe this category..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-controller="Category" asp-action="Index" class="btn btn-app-ghost">Cancel</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-circle-plus me-1" aria-hidden="true"></i> Create category
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
