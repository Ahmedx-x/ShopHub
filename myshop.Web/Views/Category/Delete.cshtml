@model Category

@{
    ViewBag.PageTitle = "Delete category";
    ViewBag.PageSubtitle = "Review before removing this category.";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

@section PageActions {
    <a asp-controller="Category" asp-action="Index" class="btn btn-app-ghost">
        <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i> Back to categories
    </a>
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card admin-form-card">
            <div class="card-body">
                <div class="alert-app alert-app--danger mb-4" role="alert">
                    <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                    <div>
                        <strong>This action cannot be undone.</strong>
                        <div>Products assigned to this category may be affected.</div>
                    </div>
                </div>

                <form asp-controller="Category" asp-action="DeleteCategory" method="post"
                      data-confirm="The category will be permanently deleted."
                      data-confirm-title="Delete this category?"
                      data-confirm-button="Delete category">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" disabled />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" rows="4" class="form-control" disabled></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-controller="Category" asp-action="Index" class="btn btn-app-ghost">Cancel</a>
                        <button type="submit" class="btn btn-danger">
                            <i class="fa-solid fa-trash me-1" aria-hidden="true"></i> Delete category
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
