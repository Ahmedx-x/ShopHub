@using System.Security.Claims
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var fullName = User.FindFirstValue("FullName");
    var displayName = string.IsNullOrWhiteSpace(fullName) ? (User.Identity?.Name ?? "Administrator") : fullName;
    var initial = string.IsNullOrWhiteSpace(displayName) ? "A" : displayName.Trim()[..1].ToUpperInvariant();
    var pageTitle = ViewBag.PageTitle as string ?? "Admin";
    var pageSubtitle = ViewBag.PageSubtitle as string;
    string NavClass(string controller) => currentController == controller ? "nav-link active" : "nav-link";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle - myShop Admin</title>

    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="~/css/adminlte.min.css" />
    <link rel="stylesheet" href="//cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="hold-transition sidebar-mini layout-fixed app-admin">
    <div class="wrapper">

        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button" aria-label="Toggle navigation">
                        <i class="fa-solid fa-bars" aria-hidden="true"></i>
                    </a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a asp-controller="Home" asp-action="Index" class="nav-link">View storefront</a>
                </li>
            </ul>

            <ul class="navbar-nav ms-auto align-items-center">
                <li class="nav-item d-none d-md-block">
                    <span class="nav-link">
                        <i class="fa-solid fa-circle-user me-1" aria-hidden="true"></i> @displayName
                    </span>
                </li>
                <li class="nav-item">
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="nav-link btn btn-link border-0">
                            <i class="fa-solid fa-right-from-bracket me-1" aria-hidden="true"></i> Logout
                        </button>
                    </form>
                </li>
            </ul>
        </nav>

        <aside class="main-sidebar sidebar-dark-primary elevation-3">
            <a asp-controller="Home" asp-action="Index" class="brand-link">
                <span class="brand-image ms-2 me-2" aria-hidden="true"><i class="fa-solid fa-bag-shopping"></i></span>
                <span class="brand-text">myShop Admin</span>
            </a>

            <div class="sidebar">
                <div class="user-panel mt-3 pb-3 mb-3 d-flex">
                    <div class="image">
                        <span class="account-menu__avatar" aria-hidden="true">@initial</span>
                    </div>
                    <div class="info">
                        <a href="#" class="d-block">@displayName</a>
                    </div>
                </div>

                <nav class="mt-2" aria-label="Admin navigation">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu">
                        <li class="nav-header">CATALOG</li>
                        <li class="nav-item">
                            <a asp-controller="Product" asp-action="Index" class="@NavClass("Product")">
                                <i class="nav-icon fa-solid fa-box-open"></i>
                                <p>Products</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Category" asp-action="Index" class="@NavClass("Category")">
                                <i class="nav-icon fa-solid fa-tags"></i>
                                <p>Categories</p>
                            </a>
                        </li>

                        <li class="nav-header">ACCESS</li>
                        <li class="nav-item">
                            <a asp-controller="User" asp-action="Index" class="@NavClass("User")">
                                <i class="nav-icon fa-solid fa-users"></i>
                                <p>Users</p>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <div class="content-wrapper">
            <section class="content-header">
                <div class="container-fluid admin-page-head">
                    <div>
                        <h1>@pageTitle</h1>
                        @if (!string.IsNullOrWhiteSpace(pageSubtitle))
                        {
                            <p>@pageSubtitle</p>
                        }
                    </div>
                    @if (IsSectionDefined("PageActions"))
                    {
                        <div class="action-group">
                            @await RenderSectionAsync("PageActions", required: false)
                        </div>
                    }
                </div>
            </section>

            <section class="content">
                <div class="container-fluid pb-4">
                    @RenderBody()
                </div>
            </section>
        </div>

        <footer class="main-footer">
            <div class="float-right d-none d-sm-inline">myShop Admin</div>
            <strong>&copy; @DateTime.Now.Year myShop.</strong>
        </footer>
    </div>

    <script src="~/plugins/jquery/jquery.min.js"></script>
    <script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/adminlte.min.js"></script>
    <script src="//cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <script src="~/plugins/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <partial name="_Toaster" />

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
