@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="container-app section">
    <div class="empty-state">
        <div class="empty-state__icon empty-state__icon--danger" aria-hidden="true">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        <h1 class="section__title">Something went wrong</h1>
        <p>An unexpected error occurred while processing your request. Please try again.</p>

        @if (Model.ShowRequestId)
        {
            <p class="text-muted-app small">
                <strong>Request ID:</strong> <code>@Model.RequestId</code>
            </p>
        }

        <div class="d-flex justify-content-center gap-2 mt-2">
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-house me-1" aria-hidden="true"></i> Back to home
            </a>
            <a class="btn btn-app-ghost" asp-controller="Shop" asp-action="Index">Browse the shop</a>
        </div>
    </div>
</div>
