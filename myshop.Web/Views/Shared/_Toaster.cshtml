@{
    var toasts = new List<object>();

    if (TempData["Create"] is string create && !string.IsNullOrWhiteSpace(create))
        toasts.Add(new { type = "success", message = create });

    if (TempData["Update"] is string update && !string.IsNullOrWhiteSpace(update))
        toasts.Add(new { type = "info", message = update });

    if (TempData["Delete"] is string delete && !string.IsNullOrWhiteSpace(delete))
        toasts.Add(new { type = "warning", message = delete });

    if (TempData["Success"] is string success && !string.IsNullOrWhiteSpace(success))
        toasts.Add(new { type = "success", message = success });

    if (TempData["Error"] is string error && !string.IsNullOrWhiteSpace(error))
        toasts.Add(new { type = "error", message = error });
}

@if (toasts.Count > 0)
{
    <script>
        (function () {
            if (typeof toastr === "undefined") { return; }
            var messages = @Html.Raw(Json.Serialize(toasts));
            messages.forEach(function (item) {
                toastr[item.type](item.message);
            });
        })();
    </script>
}
