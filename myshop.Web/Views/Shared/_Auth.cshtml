@{
    var year = DateTime.Now.Year;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is null ? "myShop" : ViewData["Title"] + " - myShop")</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-auth">
    <header class="site-header">
        <div class="container-app site-header__bar">
            <a class="site-brand" asp-controller="Home" asp-action="Index">
                <span class="site-brand__mark" aria-hidden="true"><i class="fa-solid fa-bag-shopping"></i></span>
                <span>myShop</span>
            </a>
            <a class="btn btn-app-ghost ms-auto" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i> Back to store
            </a>
        </div>
    </header>

    <main class="auth-wrap">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_Toaster" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
