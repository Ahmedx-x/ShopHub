@using Microsoft.AspNetCore.Identity
@using MyShop.Domain.Models
@using System.Security.Claims
@inject SignInManager<ApplicationUser> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    var fullName = User.FindFirstValue("FullName");
    var displayName = string.IsNullOrWhiteSpace(fullName) ? User.Identity!.Name : fullName;
    var initial = string.IsNullOrWhiteSpace(displayName) ? "U" : displayName.Trim()[..1].ToUpperInvariant();
    var isAdmin = User.IsInRole("Admin");

    <div class="account-menu" data-account-menu>
        <button type="button" class="account-menu__trigger" aria-haspopup="true" aria-expanded="false" data-account-menu-trigger>
            <span class="account-menu__avatar" aria-hidden="true">@initial</span>
            <span class="d-none d-sm-inline">@displayName</span>
            <i class="fa-solid fa-chevron-down" aria-hidden="true" style="font-size:.7rem;"></i>
        </button>

        <div class="account-menu__panel" data-account-menu-panel>
            <div class="account-menu__header">
                <span class="account-menu__name">@displayName</span>
                <span class="account-menu__meta">@User.Identity!.Name</span>
            </div>

            @if (isAdmin)
            {
                <a class="dropdown-item" asp-controller="Product" asp-action="Index">
                    <i class="fa-solid fa-box-open me-2" aria-hidden="true"></i> Products
                </a>
                <a class="dropdown-item" asp-controller="Category" asp-action="Index">
                    <i class="fa-solid fa-tags me-2" aria-hidden="true"></i> Categories
                </a>
                <a class="dropdown-item" asp-controller="User" asp-action="Index">
                    <i class="fa-solid fa-users me-2" aria-hidden="true"></i> Users
                </a>
            }
            else
            {
                <a class="dropdown-item" asp-controller="Shop" asp-action="Index">
                    <i class="fa-solid fa-store me-2" aria-hidden="true"></i> Browse products
                </a>
            }

            <form asp-controller="Account" asp-action="Logout" method="post" class="mt-1">
                @Html.AntiForgeryToken()
                <button type="submit" class="dropdown-item text-danger w-100 text-start border-0 bg-transparent">
                    <i class="fa-solid fa-right-from-bracket me-2" aria-hidden="true"></i> Logout
                </button>
            </form>
        </div>
    </div>
}
else
{
    <a class="btn btn-app-ghost" asp-controller="Account" asp-action="Login">Login</a>
    <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Register</a>
}
