@model Product
@{
    ViewData["Title"] = Model.Name;
    var related = ViewData["Related"] as IReadOnlyList<Product> ?? new List<Product>();
}

<div class="container-app section">
    <nav aria-label="Breadcrumb">
        <ol class="breadcrumb-app">
            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li><a asp-controller="Shop" asp-action="Index">Shop</a></li>
            @if (Model.Category is not null)
            {
                <li>
                    <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@Model.CategoryId">@Model.Category.Name</a>
                </li>
            }
            <li aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="product-detail">
        <div class="product-detail__media">
            @if (!string.IsNullOrWhiteSpace(Model.Img))
            {
                <img src="~/@Model.Img" alt="@Model.Name" />
            }
            else
            {
                <span class="product-detail__placeholder" aria-hidden="true"><i class="fa-solid fa-image"></i></span>
            }
        </div>

        <div class="product-detail__info">
            @if (Model.Category is not null)
            {
                <a class="product-card__category"
                   asp-controller="Shop" asp-action="Index" asp-route-categoryId="@Model.CategoryId">
                    @Model.Category.Name
                </a>
            }

            <h1>@Model.Name</h1>

            <div class="product-detail__price">$@Model.Price.ToString("N2")</div>

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="product-detail__desc">@Model.Description</p>
            }
            else
            {
                <p class="text-muted-app">No description provided for this product.</p>
            }

            <dl class="meta-list">
                <div class="d-flex justify-content-between">
                    <dt class="meta-key">Category</dt>
                    <dd class="meta-val mb-0">@(Model.Category?.Name ?? "Uncategorized")</dd>
                </div>
                <div class="d-flex justify-content-between">
                    <dt class="meta-key">Product code</dt>
                    <dd class="meta-val mb-0">#@Model.Id.ToString("D4")</dd>
                </div>
                <div class="d-flex justify-content-between">
                    <dt class="meta-key">Price</dt>
                    <dd class="meta-val mb-0">$@Model.Price.ToString("N2")</dd>
                </div>
            </dl>

            <div class="d-flex flex-wrap gap-2 mt-3">
                <a class="btn btn-primary" asp-controller="Shop" asp-action="Index">
                    <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i> Continue shopping
                </a>
                @if (Model.Category is not null)
                {
                    <a class="btn btn-app-ghost"
                       asp-controller="Shop" asp-action="Index" asp-route-categoryId="@Model.CategoryId">
                        More in @Model.Category.Name
                    </a>
                }
            </div>
        </div>
    </div>

    @if (related.Count > 0)
    {
        <div class="section">
            <div class="section__head">
                <div>
                    <h2 class="section__title">Related products</h2>
                    <p class="section__subtitle">More from @(Model.Category?.Name ?? "this category").</p>
                </div>
            </div>
            <div class="product-grid">
                @foreach (var item in related)
                {
                    <partial name="_ProductCard" model="item" />
                }
            </div>
        </div>
    }
</div>
